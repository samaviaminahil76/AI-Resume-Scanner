# Copy this file to .env. Never commit the real .env file.
# Use one provider key for the first version.
GEMINI_API_KEY=replace_with_your_key

# Application settings
APP_ENV=development
MAX_INPUT_CHARS=30000
MODEL_NAME=gemini-3-flash-preview
# Retry policy: exponential backoff after a 429/5xx response.
MAX_RETRIES=4
RETRY_BASE_DELAY_SECONDS=2
MAX_OUTPUT_TOKENS=2400
